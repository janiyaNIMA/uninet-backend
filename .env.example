# Environment variable blueprint for Uninet backend

FLASK_APP=src/uninet/main.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration (SQLite default for dev, PostgreSQL supported)
DATABASE_URL=sqlite:///uninet.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
